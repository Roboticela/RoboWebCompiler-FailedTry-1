    <frame name="Rectangle" layout="vertical" gap="12" width="fill" heightMode="hug" background="#FFFFFF" padding="16" radius="12">
        <text text="rectangle — one shape with its own fill, stroke, and a radius at every corner" fontSize="13" textColor="#86868B"/>
        <frame layout="horizontal" gap="16" width="fill" heightMode="hug" alignItems="center">
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="default 100 square" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="120" background="#F5F5F7" padding="12" radius="8">
                    <rectangle name="Square" cursor="pointer"/>
                </frame>
            </frame>
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="fixed size, stroke 3" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="120" background="#F5F5F7" padding="12" radius="8">
                    <rectangle name="Outline" width="140" height="72" fill="#FFFFFF" stroke="#0E7AFF" strokeWidth="3" radius="10"/>
                </frame>
            </frame>
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="radius 36 at the top only" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="120" background="#F5F5F7" padding="12" radius="8">
                    <rectangle name="Arch" width="120" height="72" fill="#FF9F0A" radiusTopLeft="36" radiusTopRight="36"/>
                </frame>
            </frame>
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="pill  +  rotation 45" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" gap="10" alignItems="center" justify="center" width="fill" height="120" background="#F5F5F7" padding="12" radius="8">
                    <rectangle name="Pill" width="96" height="40" fill="#30D158" radius="20"/>
                    <rectangle name="Diamond" width="48" height="48" fill="#FF3B30" rotation="45" radius="8"/>
                </frame>
            </frame>
        </frame>
    </frame>
    <frame name="Ellipse" layout="vertical" gap="12" width="fill" heightMode="hug" background="#FFFFFF" padding="16" radius="12">
        <text text="ellipse — two radii from one box, so a square box is a circle" fontSize="13" textColor="#86868B"/>
        <frame layout="horizontal" gap="16" width="fill" heightMode="hug" alignItems="center">
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="default 100 circle" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="120" background="#F5F5F7" padding="12" radius="8">
                    <ellipse id="plainDot" name="Dot"/>
                </frame>
            </frame>
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="circle with one diameter" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="120" background="#F5F5F7" padding="12" radius="8">
                    <circle name="Ring" diameter="72" fill="#0E7AFF"/>
                </frame>
            </frame>
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="ellipse 200 x 96, stroke 4" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="120" background="#F5F5F7" padding="12" radius="8">
                    <ellipse name="Oval" width="200" height="96" fill="#FF9F0A" stroke="#1D1D1F" strokeWidth="4"/>
                </frame>
            </frame>
        </frame>
    </frame>
    <frame name="Line" layout="vertical" gap="12" width="fill" heightMode="hug" background="#FFFFFF" padding="16" radius="12">
        <text text="line — two endpoints with a cap, a width, and an optional dash pattern" fontSize="13" textColor="#86868B"/>
        <frame layout="horizontal" gap="16" width="fill" heightMode="hug" alignItems="center">
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="diagonal, round cap" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="90" background="#F5F5F7" padding="12" radius="8">
                    <line name="Diagonal" x1="0" y1="0" x2="120" y2="60" width="120" height="60" stroke="#0E7AFF" strokeWidth="6" lineCap="round"/>
                </frame>
            </frame>
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="dashed 10 / 6" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="90" background="#F5F5F7" padding="12" radius="8">
                    <line name="Dashed" x1="0" y1="0" x2="160" y2="0" width="160" height="10" stroke="#FF3B30" strokeWidth="4" dash="10" dashGap="6" lineCap="round"/>
                </frame>
            </frame>
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="rotated 45 with a square cap" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="90" background="#F5F5F7" padding="12" radius="8">
                    <line name="Slash" x="0" y="0" x1="0" y1="0" x2="80" y2="0" width="80" height="8" stroke="#30D158" strokeWidth="6" lineCap="square" rotation="45"/>
                </frame>
            </frame>
        </frame>
    </frame>
    <frame name="Arrow" layout="vertical" gap="12" width="fill" heightMode="hug" background="#FFFFFF" padding="16" radius="12">
        <text text="arrow — a line with a head, so every line property still applies to it" fontSize="13" textColor="#86868B"/>
        <frame layout="horizontal" gap="16" width="fill" heightMode="hug" alignItems="center">
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="head 16 wide on a 3px stroke" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="90" background="#F5F5F7" padding="12" radius="8">
                    <arrow name="Right" x1="0" y1="0" x2="160" y2="0" width="160" height="12" stroke="#0E7AFF" strokeWidth="3" headLength="16" headWidth="14"/>
                </frame>
            </frame>
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="diagonal, round cap, head 24" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="90" background="#F5F5F7" padding="12" radius="8">
                    <arrow name="Diagonal" x1="0" y1="0" x2="120" y2="60" width="120" height="60" stroke="#30D158" strokeWidth="6" lineCap="round" headLength="24" headWidth="20"/>
                </frame>
            </frame>
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="a head at each end" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="90" background="#F5F5F7" padding="12" radius="8">
                    <arrow name="Both" x1="0" y1="0" x2="160" y2="0" width="160" height="12" stroke="#FF9F0A" strokeWidth="4" head="both" headLength="18" headWidth="16"/>
                </frame>
            </frame>
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="dashed shaft, solid head" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="90" background="#F5F5F7" padding="12" radius="8">
                    <arrow name="Dashed" x1="0" y1="0" x2="160" y2="0" width="160" height="12" stroke="#FF3B30" strokeWidth="4" dash="10" dashGap="6" lineCap="round" headLength="20" headWidth="16"/>
                </frame>
            </frame>
        </frame>
    </frame>
    <frame name="Group" layout="vertical" gap="12" width="fill" heightMode="hug" background="#FFFFFF" padding="16" radius="12">
        <text text="group — combine objects into one node; set a property once and every child follows" fontSize="13" textColor="#86868B"/>
        <frame layout="horizontal" gap="16" width="fill" heightMode="hug">
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="box hugs the union" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="88" background="#F5F5F7" padding="12" radius="8">
                    <group name="Badge" cursor="pointer">
                        <frame width="72" height="48" background="#0E7AFF" radius="10"/>
                        <frame x="48" y="16" width="48" height="24" background="#FFFFFF" radius="6"/>
                    </group>
                </frame>
            </frame>
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="box resizes every child" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="88" background="#F5F5F7" padding="12" radius="8">
                    <group name="BadgeLarge" width="140" height="64">
                        <frame width="72" height="48" background="#0E7AFF" radius="10"/>
                        <frame x="48" y="16" width="48" height="24" background="#FFFFFF" radius="6"/>
                    </group>
                </frame>
            </frame>
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="opacity 0.45 and rotation 12 cascade" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="88" background="#F5F5F7" padding="12" radius="8">
                    <group name="Faded" opacity="0.45" rotation="12">
                        <frame width="40" height="40" background="#FF9F0A" radius="8"/>
                        <frame x="20" y="20" width="40" height="40" background="#FF3B30" radius="8"/>
                    </group>
                </frame>
            </frame>
            <frame layout="vertical" gap="6" width="fill" heightMode="hug">
                <text text="nested groups multiply (0.5 x 0.5)" fontSize="12" textColor="#86868B"/>
                <frame layout="horizontal" alignItems="center" justify="center" width="fill" height="88" background="#F5F5F7" padding="12" radius="8">
                    <group name="Outer" opacity="0.5">
                        <group name="Inner" opacity="0.5">
                            <frame width="56" height="56" background="#0E7AFF" radius="8"/>
                        </group>
                    </group>
                </frame>
            </frame>
        </frame>
    </frame>
</window>
