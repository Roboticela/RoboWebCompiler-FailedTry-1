<window width="1080" height="720" title="Runtime Gallery">
    <style name="quiet" color="$color.muted" fontSize="$type.caption"/>
    <style name="title" color="$color.text" fontSize="20" fontWeight="600"/>
    <state name="note" value="Ready"/>
    <component name="Hint">
        <text style="quiet" text="{label}"/>
    </component>
    <component name="UserCard">
        <card>
            <row alignment="center" spacing="12">
                <avatar text="{name}"/>
                <column spacing="4">
                    <text text="{name}" fontWeight="600"/>
                    <slot name="content"/>
                </column>
            </row>
        </card>
    </component>
    <column width="fill" height="fill">
        <navbar>
            <text text="Runtime" fontWeight="600"/>
            <text text="Gallery" style="quiet"/>
            <spacer width="fill"/>
            <badge text="Light"/>
        </navbar>
        <row width="fill" height="fill">
            <scroll width="240" height="fill" padding="16" spacing="8" background="$color.surface">
                <button id="galleryButton" text="Ping" variant="primary" size="sm" onClick="gallery"/>
                <text id="status" text="Click Ping" style="quiet"/>
                <text text="This rail scrolls." fontWeight="600"/>
                <text text="Buttons and text"/>
                <text text="Fields and choices"/>
                <text text="Layout"/>
                <text text="Styles and state"/>
                <text text="Components and slots"/>
                <text text="Feedback"/>
                <text text="Navigation"/>
                <text text="Overlay and dialog"/>
                <text text="Line ten"/>
                <text text="Line eleven"/>
                <text text="Line twelve"/>
                <text text="Line thirteen"/>
                <text text="Line fourteen"/>
                <text text="Line fifteen"/>
                <text text="Line sixteen"/>
                <text text="Line seventeen"/>
                <text text="The thumb tracks this list."/>
            </scroll>
            <scroll width="fill" height="fill" padding="24" spacing="16">
                <header>
                    <text text="What is implemented" style="title"/>
                    <Hint label="Tokens, styles, bindings, layout, and DevKit controls."/>
                </header>
                <section spacing="8">
                    <text text="Type" style="title"/>
                    <text text="Display" role="display"/>
                    <text text="Heading" role="h2"/>
                    <text text="Body copy uses Segoe UI at 17." role="body"/>
                    <text text="Caption" role="caption"/>
                </section>
                <section spacing="8">
                    <text text="Buttons" style="title"/>
                    <row spacing="8" alignment="center">
                        <button text="Primary" variant="primary"/>
                        <button text="Secondary" variant="secondary"/>
                        <button text="Action" variant="action"/>
                        <button text="Ghost" variant="ghost"/>
                        <button text="Danger" variant="danger"/>
                    </row>
                    <row spacing="8" alignment="center">
                        <button text="Small" size="sm"/>
                        <button text="Medium" size="md"/>
                        <button text="Large" size="lg"/>
                        <iconButton text="+"/>
                        <link text="Link"/>
                        <button text="Tip" tip="Shown on hover"/>
                    </row>
                </section>
                <section spacing="8">
                    <text text="State" style="title"/>
                    <text text="{note}"/>
                    <row spacing="8">
                        <button text="Mark saved" variant="secondary" onClick="set:note=Saved"/>
                        <button text="Toggle extra" variant="ghost" onClick="toggle:extra"/>
                        <button text="Open dialog" variant="primary" onClick="show:notice"/>
                    </row>
                    <panel id="extra">
                        <text text="This panel toggles without rebuilding the tree."/>
                    </panel>
                </section>
                <UserCard name="Ada">
                    <text text="Engineer" style="quiet"/>
                </UserCard>
                <form id="signup" spacing="10">
                    <text text="Form" style="title"/>
                    <textField placeholder="Email" validation="email"/>
                    <passwordField placeholder="Password"/>
                    <textArea placeholder="Notes"/>
                    <numberField placeholder="Quantity"/>
                    <searchField/>
                    <row spacing="16">
                        <checkbox text="Remember me"/>
                        <switch text="Notifications" checked="true"/>
                    </row>
                    <radio name="plan" text="Monthly" checked="true"/>
                    <radio name="plan" text="Yearly"/>
                    <slider value="40"/>
                    <progress value="65"/>
                    <select placeholder="Choose">
                        <option text="Design"/>
                        <option text="Code"/>
                    </select>
                    <button text="Submit" variant="primary" onClick="submit:signup"/>
                </form>
                <section spacing="8">
                    <text text="Layout" style="title"/>
                    <text text="Half width" width="50%"/>
                    <row width="fill" spacing="8">
                        <button text="Grow" grow="1"/>
                        <button text="Fixed" width="120"/>
                    </row>
                    <grid columns="3" columnGap="8" rowGap="8">
                        <button text="One"/>
                        <button text="Two" columnSpan="2"/>
                        <button text="Three"/>
                    </grid>
                    <flex gap="8">
                        <badge text="Flex"/>
                        <badge text="Row" tone="info"/>
                    </flex>
                    <wrap gap="8">
                        <badge text="Wrap"/>
                        <badge text="One"/>
                        <badge text="Two"/>
                        <badge text="Three"/>
                    </wrap>
                    <stack width="fill" height="72">
                        <panel width="fill" height="72"/>
                        <text text="Stacked" zIndex="4"/>
                    </stack>
                    <absolute width="fill" height="64">
                        <badge text="Absolute" x="12" y="16"/>
                    </absolute>
                    <split height="80" ratio="0.4">
                        <panel><text text="Left"/></panel>
                        <panel><text text="Right"/></panel>
                    </split>
                    <overlay width="fill" height="72" background="$color.surface">
                        <text text="Overlay centers this"/>
                    </overlay>
                    <clip width="160" height="36">
                        <text text="Clipped text that runs past the box"/>
                    </clip>
                    <aspect ratio="0.5" width="160">
                        <panel width="fill" height="fill"><text text="Aspect"/></panel>
                    </aspect>
                    <row spacing="12" alignment="center">
                        <spacer width="24"/>
                        <text text="Before"/>
                        <divider width="80"/>
                        <text text="After"/>
                    </row>
                </section>
                <section spacing="8">
                    <text text="Feedback" style="title"/>
                    <alert title="Info" text="Solid fills only." tone="info"/>
                    <alert title="Success" text="The form can validate email." tone="success"/>
                    <alert title="Warning" text="Bindings still cover strings and bools." tone="warning"/>
                    <alert title="Danger" text="Shadows and gradients stay off." tone="danger"/>
                    <row spacing="8">
                        <badge text="Default"/>
                        <badge text="Info" tone="info"/>
                        <skeleton lines="3" width="220"/>
                    </row>
                    <empty title="Nothing here" text="Empty state"/>
                </section>
                <section spacing="8">
                    <text text="Navigation" style="title"/>
                    <breadcrumb>
                        <text text="Home"/>
                        <text text="Gallery"/>
                        <text text="Layout"/>
                    </breadcrumb>
                    <pagination pages="5" page="2"/>
                    <tabs>
                        <tab title="First"><text text="First tab body"/></tab>
                        <tab title="Second"><text text="Second tab body"/></tab>
                    </tabs>
                    <list>
                        <listItem><text text="Inbox"/></listItem>
                        <listItem><text text="Archive"/></listItem>
                    </list>
                    <menu>
                        <menuItem text="Open" onClick="set:note=Open"/>
                        <menuItem text="Close" onClick="hide:notice"/>
                    </menu>
                </section>
                <image source="mark" width="120" height="72"/>
                <footer>
                    <text text="Hidden below 400" hiddenBelow="400" style="quiet"/>
                    <text text="Gallery" style="quiet"/>
                </footer>
            </scroll>
        </row>
    </column>
    <dialog id="notice" visible="false">
        <card width="360">
            <text text="Dialog" role="h3"/>
            <text text="The scrim covers the window. Close returns to the gallery."/>
            <button text="Close" variant="secondary" onClick="hide:notice"/>
        </card>
    </dialog>
</window>
